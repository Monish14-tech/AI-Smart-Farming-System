# ─────────────────────────────────────────────────────────────
# AgriNova — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── Supabase / PostgreSQL ─────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → Database → Connection string
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# Direct connection (for Prisma migrations)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET="your-super-secret-access-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Google Gemini AI ──────────────────────────────────────────
# Get free key at: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key"

# ── Mapbox ────────────────────────────────────────────────────
# Get free token at: https://account.mapbox.com/
MAPBOX_TOKEN="pk.your-mapbox-public-token"
# Also add this to frontend .env.local as NEXT_PUBLIC_MAPBOX_TOKEN

# ── Cloudinary ────────────────────────────────────────────────
# Get free credentials at: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── Razorpay (sandbox) ────────────────────────────────────────
# Get free sandbox keys at: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID="rzp_test_your-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-secret"

# ── Backend Server ────────────────────────────────────────────
PORT=5000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# ── Frontend (Next.js) ────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your-mapbox-public-token"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your-key-id"
